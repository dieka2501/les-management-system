# Les Management System environment example

# Server lokal
HOST=127.0.0.1
PORT=8001
LES_SEED_DEMO=0

# Local default:
LES_DB_PATH=backend/data/les.sqlite3
#
# Railway production dengan SQLite:
# - Attach Railway Volume, rekomendasi mount path: /data
# - Jika LES_DB_PATH dikosongkan, app otomatis memakai:
#   $RAILWAY_VOLUME_MOUNT_PATH/les.sqlite3
# - Atau set eksplisit:
# LES_DB_PATH=/data/les.sqlite3

# Login area internal: dashboard operasional + simulator chatbot/provider
APP_AUTH_PASSWORD=change-me
APP_AUTH_SECRET=change-me-session-secret
#
# Alias lama tetap didukung jika sudah terlanjur dipakai:
# CHATBOT_TEST_PASSWORD=change-me
# CHATBOT_AUTH_SECRET=change-me-session-secret

# Gemini AI
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Instagram DM webhook
IG_WEBHOOK_VERIFY_TOKEN=change-me-instagram-verify-token
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_REPLY_MODE=gemini
IG_SEND_ENABLED=0
IG_GRAPH_API_VERSION=v25.0

# Alias opsional jika ingin memakai prefix INSTAGRAM_.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
